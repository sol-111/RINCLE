able":false},"type":"Message","name":"or_","is_slidable":false},"type":"Message","name":"get_not_data","is_slidable":false},"properties":{"element_id":"bTPFh"},"type":"GetElement","is_slidable":false},"properties":{"button_disabled":true},"type":"State"}},"type":"Button","id":"bTOlB","default_name":"Button Y","style":"Button_primary_button_"}},"style":"Group_default_group_"}},"style":"Group_default_group_"},"bTPFp":{"properties":{"height":0,"left":0,"top":767,"width":0,"zindex":16,"vertical_centering":true,"order":16,"row_gap":24,"use_gap":true,"fit_width":false,"fit_height":true,"single_width":false,"min_width_css":"40px","single_height":false,"min_height_css":"40px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTPFn","default_name":"Group GZZZZZZ","elements":{"bTPFu":{"properties":{"height":0,"left":0,"top":-1356,"width":0,"zindex":14,"vertical_centering":true,"order":1,"row_gap":28,"use_gap":true,"fit_width":false,"fit_height":true,"single_width":false,"min_width_css":"40px","single_height":false,"min_height_css":"40px","horiz_alignment":"center","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTPFJ","default_name":"Group EZZZZZZ","elements":{"bTPFP":{"properties":{"text":{"entries":{"0":"レンタル利用規約"},"type":"TextExpression"},"height":36,"left":0,"top":-1356,"width":100,"zindex":5,"font_color":"var(--color_text_default)","font_size":20,"letter_spacing":1,"vertical_centering":true,"order":1,"fit_width":true,"fit_height":true,"font_weight":"700","single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","vert_alignment":"center","horiz_alignment":"center"},"type":"Text","id":"bTPEx","current_parent":"bTOlM","default_name":"Text EZZZZZ"},"bTPFW":{"properties":{"height":0,"left":0,"top":48,"width":0,"zindex":6,"border_roundness":5,"vertical_centering":true,"background_style":"bgcolor","border_style":"solid","order":2,"fit_width":false,"fit_height":true,"padding_top":12,"padding_left":12,"single_width":false,"min_width_css":"40px","padding_right":12,"single_height":false,"max_height_css":"200px","min_height_css":"40px","padding_bottom":12,"horiz_alignment":"center","overflow_scroll":true,"container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTPFR","default_name":"Group FZZZZZZ","elements":{"bTPFX":{"properties":{"text":{"entries":{"0":"レンタル利用規約\nこのレンタル利用規約（以下「本規約」という）は、PEDAL STANDARD株式会社が提供・運営する「RINCLE」プラットフォームサービス（以下「本サービス」という）を通じて、加盟店（以下「貸出店舗」という）が貸出しする自転車及び自転車用品（以下「レンタルバイク等」という）について、貸出店舗、レンタルバイク等を借受する人（以下「ユーザー」という）及びレンタルバイク等を利用し、運転する人（以下「運転者」という）との契約（以下「レンタル契約」という）について定めたものです。なお、本規約に定めのない事項については、法令又は一般の慣習によるものとします。\n\n第１条.利用資格\nレンタルバイク等は、次の各号の全部に適合するユーザー及び運転者のみ、利用することができます。\n本規約及びその他の交通規則等を遵守することができる方。\n貸出店舗からの連絡が可能な電話番号を所有している方。\n貸出日に身分証明書を携帯しており、貸出店舗のスタッフに提示することができる方。\nスポーツサイクルを含む自転車の利用に耐えうる健康状態の方。\n酒気を帯びていない方。\n麻薬、覚せい剤、シンナー等による中毒症状等を呈していない方。\n反社会的勢力及びその関係者でない方。\n感染症、その他、他人に伝染及び感染する恐れのある疫病のない方。\n18歳未満の場合、貸出期間中、親権者又は18歳以上の方（以下「保護者」という）が同伴できる方。なお この場合、レンタル利用申込に際し、保護者の自筆署名と、保護者の身分証明書の提示が必要となります。保護者は本規約に基づく責任を本人と連帯して負うものとします。\n過去にレンタル料金や修理代金の滞納がない方。\nその他、貸出店舗が利用に適すると判断した方。\n\n第２条.予約の申込\nユーザーは、本サービスより、貸出店舗、貸出車種及び個別の貸出自転車用品、レンタル開始日時、返却日時、運転者、付属品の要否及びその他条件（以下「レンタル条件」という）を入力し、運転者がユーザーと異なるときは運転者に本規約の内容を承諾させた上で、予約の申込を行うことができます。貸出店舗が、予約の申込みを承諾したときに、レンタル契約が成立するものとします。\n\n第３条.予約の変更等\nユーザーは、レンタル条件を変更しようとするときは、第4条に従って予約の取消しを行い、前条に従って再度予約の申込みを行なわなければならないものとします。\n\n貸出店舗は、ユーザーから予約のあったレンタル条件に該当するレンタルバイク等の貸出ができないときは、直ちにその旨をユーザーに通知するものとします。\n\n貸出店舗は、前項の場合で、予約のあった条件以外の代替レンタルバイク等を貸出すことが可能なときは、ユーザーに予約と異なる条件のレンタルバイク等の貸出しの申込みを行うことができるものとします。\n\nユーザーが前項の申込みを拒絶した場合、予約は取消されるものとし、貸出店舗はレンタル料金の決済処理を中止し又は受領済のレンタル料金をユーザーに返還します。\n\n第４条.予約の取消等\nユーザー及び貸出店舗は、本サービス、メール又は電話を用いて相手へ通知することで予約を取消すことができます。\n\nユーザーから貸出店舗に対する連絡がなくレンタル開始日時から1時間が経過した時点で自動キャンセルとなり、ユーザーの都合によるキャンセルとして、次項に規定する所定のキャンセル料が発生します。\n\nユーザーの都合により予約がレンタル開始当日のレンタル開始時間の２時間前までに貸出店舗に対する連絡がなく取消されたときは、ユーザーは、キャンセル料金としてレンタル料金の100%を本サービスを通じて貸出店舗に支払うものとします。\n\n貸出店舗の都合により予約が取消された場合は、キャンセル料は発生せず、貸出店舗は、レンタル料金の決済処理を中止し又は受領済のレンタル料金をユーザーに返還します。\n\nユーザーは、レンタル期間中であっても、貸出店舗の同意を得た場合、レンタル契約をキャンセルすることができます。\n\n\n\n第５条.レンタル利用の手続\n事故盗難その他、貸出店舗の責によらない事由により、レンタル開始日時にユーザーが予約したレンタルバイク等を引渡すことができない場合には、貸出店舗は予約を取消すことができるものとします。なお、この場合の予約の取消等の扱いについては、第4条4項を適用するものとします。\n\n貸出店舗において実施されるレンタル利用の手続きは以下のとおりとします。\n\nユーザーは、貸出店舗のスタッフとともに、レンタル期間等のレンタル条件を確認します。\nユーザー又は運転者は、店舗所定の申込書に必要事項を記入します。\nユーザー又は運転者は、申込書とともに身分証明書を店舗スタッフに提示します。店舗スタッフは、身分証明書の確認を行い、場合によっては、番号を控えさせていただきます。\n店舗スタッフから、ユーザー又は運転者にレンタルバイク等について、取扱説明を行います。\n店舗スタッフは、ユーザー又は運転者に合わせてレンタルバイク等を調整します。\nユーザー又は運転者と店舗スタッフは、レンタルバイク等に整備不良がないこと等をともに確認します。\n店舗スタッフは、ユーザー又は運転者にレンタルバイク等を引き渡します。\n\n貸出店舗は、ユーザー又は運転者が以下に該当する場合には、レンタル契約の締結を拒絶するとともに、予約を取消すことができるものとします。なお、本項各号の規定により本契約を解除した場合には、ユーザー又は運転者に損害が生じても、貸出店舗は何らこれを賠償することは要せず、また、かかる解除により貸出店舗に損害が生じたときは、ユーザー又は運転者はその損害を賠償するものとします。\n\nユーザー又は運転者が、第1条の利用資格を満たさないことが判明した場合。\nユーザー又は運転者が、本サービスの利用に必要な行為能力が制限されており、法定代理人の同意を得ていなかった場合\n申込書に記載された情報と本人確認書類の情報が異なる場合。\n予約申込で登録した身長と実際の身長が異なり、貸出自転車の適応身長に合わない場合。\n本規約に違反する行為があった場合。\n貸出店舗の店舗スタッフの必要な指示に従わなかった場合。\nその他、貸出店舗が利用に適さないと合理的な根拠に基づき判断した場合。\n\n第６条.レンタルバイク等の返却\nユーザーは、レンタルバイクを、レンタル契約に定められた返却日時までに、所定の返還場所に返却するものとします。\n\nユーザーは、レンタルバイク等を、通常の使用による劣化・摩耗を除き、引渡時と同じ状態で返却するものとします。\n\nユーザーは、貸出店舗の承諾を得た場合、返還場所を変更することができます。ただし、ユーザー又は運転者は、その場合に必要となる回送のための費用（以下「回送費用」という）を負担するものとします。なお、貸出店舗の承諾を得ずに返還場所を変更した場合、回送費用に加えて、当該変更によって貸出店舗に損害が生じたときには、ユーザーはその損害を賠償するものとします。\n\n第７条.レンタル期間の延長・返却遅延\nユーザーは、レンタル契約に定められた返却日時までに貸出店舗に連絡し、貸出店舗の承諾を得た場合、レンタル期間を延長することができるものとします。\n\n前項の規定によりレンタル期間を延長した場合、ユーザーは貸出店舗所定の延長料金を貸出店舗に支払うものとします。\n\nユーザーは、貸出店舗の事前承諾を得ずにレンタル期間を延長（返却遅延）した場合、前項の延長料金に加えて、当該延長料金の倍額に相当する違約料を支払うものとします。また、返却遅延により次のユーザーがレンタルバイク等を使用できない等、貸出店舗及び第三者に損害を与えた場合には、ユーザーはその損害を賠償するものとします。\n\n第８条.故障・破損\nユーザー又は運転者は、善良な管理者の注意をもってレンタルバイク等を使用し、保管するものとします。\n\nユーザー又は運転者は、レンタルバイク等の使用中に異常又は故障を発見したときは、直ちに使用を中止し、貸出店舗に連絡するとともに、貸出店舗の指示に従うものとします。\n\nユーザー又は運転者の責に帰すべき事由により、レンタルバイク等が故障し又は破損した場合、貸出店舗は損害金額をユーザー又は運転者に請求することができます。\n\n第９条.盗難・紛失\nユーザー又は運転者は、レンタル期間中に、レンタルバイク等の盗難又は紛失があった場合、速やかに貸出店舗及び最寄りの警察に連絡するものとします。\n\nユーザー又は運転者の責に帰すべき事由により、レンタルバイク等が盗難され又は紛失した場合、損害金額をユーザー又は運転者に請求することができます。\n\n第１０条.事故\nユーザー又は運転者は、レンタルバイク等の使用中に事故が発生したときは、直ちに運転を中止し、速やかに警察に連絡する等法令で定められた措置をとるとともに、速やかに貸出店舗に連絡するものとします。\n\n事故についての示談等が必要な場合には、ユーザー又は運転者自らの責任で処理・解決するものとし、貸出店舗は、事故や怪我・その他のトラブルに関して一切の責任を負わないものとします。\n\n事故に関し、貸出店舗又は第三者に損害を与えた場合、ユーザー又は運転者はその損害を賠償するものとします。ただし、専ら第三者の責めに帰すべき事由による事故など、不可抗力による事故であってユーザー又は運転者の責めに帰することができない事由による場合を除きます。\n\n事故起因によるレンタルバイク等の故障によってユーザー、運転者又は第三者に損害が発生したとしても、貸出店舗は一切の責任を負わないものとします。\n\n貸出店舗の責に帰すべき事由（ただし故意及び重過失を除く）により、ユーザー又は運転者に損害が発生した場合、貸出店舗は、レンタサイクル事業者向け自転車損害賠償保険の補償範囲内でこれを補償するものとし、当該補償限度額を超える損害については、ユーザー又は運転者の負担とします。\n\nユーザー又は運転者の責に帰すべき事由により、前項の保険が適用されない場合、その損害はユーザー又は運転者の負担とします。\n\n第１１条.禁止行為\nユーザー又は運転者は、レンタル期間中に次の行為をしてはならないものとします。\n\n申込書に記入した使用者以外にレンタルバイク等を使用させること。\n無謀な運転、酒気帯び運転、その他交通規則に違反すること。\n危険箇所、不適当な場所又は方法でレンタルバイク等を使用すること。\n歩行者等の通行障害となるような行為をすること。\nヘルメットを着用せずにレンタルバイク等を運転すること。\nレンタルバイク等を改造又は改装する等その原状を変更すること。\nレンタルバイク等を業務利用すること。\n自転車放置禁止区域等にレンタルバイク等を駐輪又は放置すること。\n貸出店舗の同意を得ずに、レンタルバイク等をレース等の競技に使用すること。\nその他法令諸規則に違反する行為をすること。\n\nユーザーは、前項（ケ）の行為を行うことについて、貸出店舗の事前の承諾を得た場合に限り、前項（ケ）の行為を行うことができるものとします。\n\n第１２条.レンタル契約の途中終了\nレンタル期間中において故障・事故・盗難その他の事由（以下「故障等」という）によりレンタルバイク等が使用できなくなったときは、レンタル契約は途中終了するものとします。\n\nユーザー又は運転者は、前項の場合、レンタルバイク等の引取及び修理等に要する費用を負担するものとし、貸出店舗は受領済みのレンタル料金を返還しないものとします。ただし、故障等が第3項又は本項第5号に定める事由による場合はこの限りでないものとします。\n\n故障等が貸出前に存した瑕疵による場合は、ユーザーは貸出店舗から代替レンタルバイク等の提供を受けることができるものとします。なお、代替レンタルバイク等の提供条件については、第3条第3項を準用するものとします。\n\nユーザーが前項の代替レンタルバイク等の提供を受けないときは、貸出店舗は受領済のレンタル料金を全額返還するものとします。なお、貸出店舗が代替レンタルバイク等を提供できないときも同様とします。\n\n故障等がユーザー、運転者及び貸出店舗のいずれの責にも帰すべからざる事由により生じた場合は、貸出店舗は、受領済みのレンタル料金から、貸出しからレンタル契約の終了までの期間に対応するレンタル料金を差し引いた残額をユーザーに返還するものとします。\n\nユーザー及び運転者は、本条に定める措置を除き、レンタルバイク等を使用できなかったことにより生ずる損害について貸出店舗に対し、本条に定める以外のいかなる請求もできないものとします。\n\n第１３条.レンタル契約の解除・解約\n貸出店舗は、ユーザー又は運転者がレンタル期間中に本規約に違反したときは、何らの通知・催告を要せずレンタル契約を解除し、直ちにレンタルバイク等の返還を請求、又はレンタルバイク等を回収することができるものとします。この場合、貸出店舗は受領済のレンタル料金をユーザーに返還しないものとします。\n\n\n第１４条.本規約の変更\n貸出店舗は、いつでも本規約の全部又は一部を変更できるものとします。ただし、本規約の全部又は一部を変更する場合、貸出店舗は、本規約変更の効力発生日を定めた上で、本規約を変更する旨及び変更後の本規約の内容並びにその効力発生日を、貸出店舗所定の方法でユーザー及び運転者に事前に周知するものとします。\n本規約の全部又は一部が変更された場合、その効力発生日以降、変更後の本規約が適用されるものとし、ユーザー、運転者及び貸出店舗は変更後の本規約のみに従うものとします。\n\n第１５条.分離可能性\n本規約のいずれかの条項又はその一部が、民法その他の法令等により無効又は執行不能と判断された場合であっても、本規約の残りの規定及び一部が無効又は執行不能と判断された規定の残りの部分は、継続して完全に効力を有し、加盟店は、当該無効若しくは執行不能の条項又は部分を適法とし、執行力を持たせるために必要な範囲で修正し、当該無効若しくは執行不能な条項又は部分の趣旨並びに法律的及び経済的に同等の効果を確保できるように努めるものとします。\n\n第１６条.信義則\n本規約の内容に疑義が生じた場合又は本規約に記載していない事項が生じた場合、ユーザー、運転者及び貸出店舗は、誠意を持って協議し、解決に努めるものとします。\n\n第１７条.準拠法・管轄裁判所\n本規約の準拠法は日本法とし、本規約に起因又は関連して生じた一切の紛争（裁判所の調停手続を含みます。）は、貸出店舗の所在地を管轄する地方裁判所をもって第一審の専属的合意管轄裁判所とすることに合意します。\n\n\n2025年７月２５日制定\n"},"type":"TextExpression"},"height":36,"left":0,"top":-48,"width":100,"zindex":5,"border_roundness":5,"font_alignment":"left","font_color":"var(--color_text_default)","font_size":12,"line_height":1.5,"letter_spacing":1,"vertical_centering":true,"background_style":"none","bgcolor":"rgba(255,255,255,1)","border_style":"none","order":1,"fit_width":true,"unique_id":{"entries":{"0":""},"type":"TextExpression"},"fit_height":true,"margin_top":0,"font_weight":"500","padding_top":16,"padding_left":16,"single_width":true,"min_width_css":"100%","padding_right":16,"single_height":false,"min_height_css":"64px","padding_bottom":16,"vert_alignment":"center","horiz_alignment":"center","title_attribute":{"entries":{"0":""},"type":"TextExpression"}},"type":"Text","id":"bTPFD","current_parent":"bTOlM","default_name":"Text FZZZZZ","name":"Text 1. 本規約の適用   - この利用"},"bTbim2":{"properties":{"height":36,"left":0,"top":0,"width":100,"zindex":6,"font_color":"var(--color_primary_contrast_default)","vertical_centering":true,"order":2,"fit_width":true,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"Text","id":"bTbih2","default_name":"Text CZZZZZZZZZ","name":"Text スクロール確認"}},"name":"Group 規約スクロール","style":"Group_default_group_"}},"style":"Group_default_group_"},"bTcyw":{"properties":{"height":0,"left":0,"top":272,"width":0,"zindex":16,"vertical_centering":true,"order":2,"row_gap":12,"use_gap":true,"fit_width":false,"fit_height":true,"single_width":false,"min_width_css":"40px","single_height":false,"min_height_css":"40px","horiz_alignment":"flex-start","container_layout":"column","collapse_when_hidden":true},"type":"Group","id":"bTcyr","default_name":"Group GZZZZ","elements":{"bTczB":{"properties":{"height":36,"left":0,"top":-272,"width":180,"zindex":15,"icon":"material outlined square","font_size":14,"vertical_centering":true,"label":{"entries":{"0":"自転車に乗る方全員の免許証などの身分証明書を持参することに同意する"},"type":"TextExpression"},"order":3,"fit_width":true,"fit_height":true,"font_weight":"600","single_width":false,"min_width_css":"180px","single_height":false,"horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"Checkbox","id":"bTcyN","current_parent":"bTPFn","default_name":"Checkbox I","name":"Checkbox 自転車に乗る方全員の免許証などの身分証明書を持参することに同意する","style":"Checkbox_standard_checkbox_"},"bTdyl":{"properties":{"height":36,"left":10,"top":-262,"width":180,"zindex":15,"icon":"material outlined square","font_size":14,"vertical_centering":true,"label":{"entries":{"0":"自転車に乗る方が18歳未満の場合、親権者または18歳以上の方が同伴することに同意する"},"type":"TextExpression"},"order":4,"fit_width":true,"fit_height":true,"font_weight":"600","single_width":false,"min_width_css":"180px","single_height":false,"horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"Checkbox","id":"bTdyg","current_parent":"bTcyr","default_name":"Checkbox N","name":"Checkbox 自転車に乗る方が18歳未満の場合、親権者または18歳以上の方が同伴することに同意する","style":"Checkbox_standard_checkbox_"},"bTeVB":{"properties":{"text":{"entries":{"0":"＊特に下記の事項に留意事項をご確認ください。"},"type":"TextExpression"},"height":36,"left":167,"top":28.796875,"width":100,"zindex":16,"vertical_centering":true,"order":2,"fit_width":true,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","