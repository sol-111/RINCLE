erties":{"element_id":"bTfHh"},"type":"GetElement","is_slidable":false},"8":"\n【メール】","9":{"next":{"type":"Message","name":"get_data","is_slidable":false},"properties":{"element_id":"bTfHu"},"type":"GetElement","is_slidable":false},"10":"\n【お問い合わせ内容】\n","11":{"next":{"type":"Message","name":"get_data","is_slidable":false},"properties":{"element_id":"bTVyW0"},"type":"GetElement","is_slidable":false},"12":"\n\n※ ご入力いただいたメールアドレスに誤りがないかご確認ください。\n※ 数日経っても返信が届かない場合は、迷惑メールフォルダをご確認いただくか、お手数ですが再度ご連絡ください。\n※ お問い合わせ内容によっては、回答にお時間をいただく場合がございます。あらかじめご了承ください。\n\n（本メールは自動返信です）"},"type":"TextExpression"},"subject":{"entries":{"0":"（RINCLE）お問い合わせを受け付けました"},"type":"TextExpression"},"sender_name":{"entries":{"0":"Rincle"},"type":"TextExpression"}},"type":"SendEmail","id":"bTgDL"},"2":{"properties":{"condition":{"next":{"type":"Message","name":"is_not_empty","is_slidable":false},"properties":{"action_id":"bTVzL0"},"type":"PreviousStep","is_slidable":false},"to":{"entries":{"0":"","1":{"next":{"type":"Message","name":"contact_mail_text","is_slidable":false},"type":"CurrentPageItem","is_slidable":false},"2":""},"type":"TextExpression"},"body":{"entries":{"0":"平素よりRINCLEにご協力いただき、誠にありがとうございます。\n本メールは、RINCLE公式サイトのお問い合わせフォームより、貴販売店様宛に寄せられた内容を転送しております。\n\nお客様へのご対応をよろしくお願いいたします。\n\n＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝\n【お問い合わせ種別】","1":{"next":{"next":{"type":"Message","name":"___text","is_slidable":false},"type":"Message","name":"get_data","is_slidable":false},"properties":{"element_id":"bTVyQ0"},"type":"GetElement","said":"cmluY2xl","is_slidable":false},"2":"\n【お名前】","3":{"next":{"type":"Message","name":"get_data","is_slidable":false},"properties":{"element_id":"bTfHh"},"type":"GetElement","said":"cmluY2xl","is_slidable":false},"4":"\n【メール】","5":{"next":{"type":"Message","name":"get_data","is_slidable":false},"properties":{"element_id":"bTfHu"},"type":"GetElement","said":"cmluY2xl","is_slidable":false},"6":"\n【お問い合わせ内容】\n","7":{"next":{"type":"Message","name":"get_data","is_slidable":false},"properties":{"element