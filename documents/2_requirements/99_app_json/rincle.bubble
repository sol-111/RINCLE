場合、キャンセル料金としてレンタル料金の100%を当店舗に支払うものとします。また、当店舗に対する連絡なくレンタル開始日時から１時間が経過した時点で、レンタルは自動キャンセルとなり、同様のキャンセル料金（レンタル料金の100%）を支払うものとします。\n\n当店舗の都合により予約がキャンセルされた場合は、キャンセル料は発生せず、当店舗は、レンタル料金の決済処理を中止し又は受領済のレンタル料金をお客様に返還します。\n\nその他\nその他特別な販売条件又は提供条件がある商品又はサービスについては、それぞれの購入ページにおいて条件を表示します。\n2025年7月25日 制定\n"},"type":"TextExpression"},"height":36,"left":-379.7734375,"top":-16,"width":100,"zindex":2,"font_color":"var(--color_text_default)","font_size":14,"line_height":1.5,"vertical_centering":true,"order":1,"fit_width":false,"fit_height":true,"font_weight":"500","single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","vert_alignment":"center","horiz_alignment":"flex-start"},"states":{"0":{"condition":{"next":{"args":765,"type":"Message","name":"less_or_equal_than","is_slidable":false},"properties":{"element_id":"bTGYf","name":"Current Page Width"},"type":"PageData","said":"cmluY2xl","is_slidable":false},"properties":{"font_size":12,"min_width_css":"100%"},"type":"State"}},"type":"Text","id":"bTdlf","current_parent":"bTKjd","default_name":"Text A"}},"style":"Group_default_group_"}},"style":"Group_default_group_"}},"name":"Group 利用規約","style":"Group_default_group_"},"bTdlr":{"properties":{"height":280,"left":127.5,"top":39,"width":280,"zindex":4,"vertical_centering":true,"background_style":"bgcolor","bgcolor":"rgba(247,247,247,1)","order":4,"fit_width":false,"fit_height":true,"margin_top":0,"padding_top":32,"single_width":false,"margin_bottom":120,"min_width_css":"40px","single_height":false,"min_height_css":"40px","horiz_alignment":"flex-start","container_layout":"column"},"type":"Group","id":"bTdMo","default_name":"Group C","name":"Group search main","style":"Group_default_group_"}},"name":"Group Search","custom_states":{"selected_shops_":{"display":"selected_shops","value":"list.user","make_static":true}}}},"name":"Group Search","style":"Group_default_group_","custom_states":{"selected_shops_":{"display":"selected_shops","value":"list.user","make_static