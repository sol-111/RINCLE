id":"bTTiD","custom_state":"custom.____","custom_states_values":{"0":{"value":true,"custom_state":"custom.change_"}}},"type":"SetCustomState","id":"bTTkg"},"2":{"properties":{"custom_event":"bTTxX"},"type":"TriggerCustomEvent","id":"bTTyS"},"3":{"properties":{"AAh":{"entries":{"0":"// 全てのsimu_priceクラスの要素を取得し、display: none でないもののみ処理\nconst priceElements = Array.from(document.querySelectorAll('.simu_price'))\n  .filter(el => window.getComputedStyle(el).display !== 'none') // display: none を除外\n  .flatMap(el => Array.from(el.querySelectorAll('div'))); // 内部<div>要素を取得\n\nconsole.log(priceElements);\n\n// 合計を計算\nconst total = priceElements\n  .map(element => element.textContent.trim()) // テキストを取得してトリム\n  .map(value => String(value).slice(1)) // 最初の文字を削除（文字列に明示的に変換してから）\n  .map(value => value.replace(/,/g, '')) // カンマを削除\n  .map(value => Number(value)) // 数値に変換\n  .filter(value => !isNaN(value)) // NaNを除外\n  .reduce((sum, value) => sum + value, 0); // 数値として合計を計算\n\nconsole.log(`合計値: ${total}`);\nconst formattedTotal = new Intl.NumberFormat('ja-JP').format(total);\n\nbubble_fn_simu_price(formattedTotal);\n"},"type":"TextExpression"}},"type":"1488796042609x768734193128308700-AAg","id":"bTTzr","name":"Run javascript"}}},"bTTkb":{"properties":{"element_id":"bTVhj","event_color":"red"},"type":"InputChanged","id":"bTTkZ","actions":{"0":{"properties":{"value":{"next":{"next":{"args":{"next":{"type":"Message","name":"get_data","is_slidable":false},"properties":{"element_id":"bTVhj"},"type":"ThisElement","is_slidable":false},"type":"Message","name":"change_time","is_slidable":false},"type":"Message","name":"get_data","is_slidable":false},"properties":{"element_id":"bTTiK"},"type":"GetElement","is_slidable":false},"element_id":"bTTiD","custom_state":"custom.____"},"type":"SetCustomState","id":"bTTkf"},"1":{"properties":{"custom_event":"bTTxX"},"type":"TriggerCustomEvent","id":"bTTxt"},"2":{"properties":{"AAh":{"entries":{"0":"// 全てのsimu_priceクラスの要素を取得し、display: none でないもののみ処理\ncons