// display: none ではない .simu_price 要素を取得\nconst visiblePriceElements = Array.from(document.querySelectorAll('.simu_price'))\n  .filter(el => window.getComputedStyle(el).display !== 'none');\n\n// 指定したインデックスの .simu_price 要素を取得\nif (visiblePriceElements.length > TARGET_INDEX) {\n  const targetElement = visiblePriceElements[TARGET_INDEX];\n\n  // 内部の数値を持つ要素を取得（最初の <div> を対象とする）\n  const priceElement = targetElement.querySelector('div');\n\n  if (priceElement) {\n    let value = priceElement.textContent.trim(); // テキストを取得してトリム\n    value = value.slice(1); // 最初の文字を削除（例: ¥123,456 → 123,456）\n    value = value.replace(/,/g, ''); // カンマを削除\n    const numericValue = Number(value); // 数値に変換\n\n   console.log(numericValue)\n\n    if (!isNaN(numericValue)) {\n      console.log(`取得した値: ${numericValue}`);\n      const formattedValue = new Intl.NumberFormat('ja-JP').format(numericValue);\n      \n     console.log(`成形した値: ${formattedValue}`)\n      // 結果を関数に渡す\n      bubble_fn_simu_price_op(numericValue);\n    } else {\n      console.warn('数値に変換できませんでした:', value);\n    }\n  } else {\n    console.warn(`.simu_price の ${TARGET_INDEX + 1} 番目の要素に <div> がありません。`);\n  }\n} else {\n  console.warn(`表示されている .simu_price 要素が ${TARGET_INDEX + 1} 個未満です。`);\n}\n"},"type":"TextExpression"}},"type":"1488796042609x768734193128308700-AAg","id":"bTUoA"},"1":{"properties":{"condition":{"next":{"next":{"args":{"next":{"type":"Message","name":"parameter","is_slidable":false},"properties":{"option_set":"option.index_page","option_value":"bicycle_detail"},"type":"OptionValue"},"type":"Message","name":"equals","is_slidable":false},"type":"Message","name":"last_element","is_slidable":false},"properties":{"type":"path_segment"},"type":"GetParamFromUrl"},"AAh":{"entries":{"0":"// 全てのsimu_priceクラスの要素を取得し、display: none でないもののみ処理\nconst priceElements = Array.from(document.querySelectorAll('.simu_price'))\n  .filter(el => window.getComputedStyle(el).display !== 'none') // display: none を除外\n  .flatMap(el => Array.from(el.querySelectorAll('div'))); // 内部<div>要素を取得\n\nconsole.log(priceElements);\n\n// 合計を計算\nconst total = priceElements\n  .map(element => element.textContent.trim()) // テキストを取得してトリム\n  .map(value => String(value).slice(1)) // 最初の文字を削除（文字列に明示的に変換してから）\n  .map(value => value.replace(/,/g, '')) // カンマを削除\n  .map(value => Number(value)) // 数値に変換\n  .filter(value => !isNaN(value)) // NaNを除外\n  .reduce((sum, value) => sum + value, 0); // 数値として合計を計算\n\nconsole.log(`合計値: ${total}`);\nconst formattedTotal = new Intl.NumberFormat('ja-JP').format(total);\n\nbubble_fn_simu_price(formattedTotal);\n"},"type":"TextExpression"}},"type":"1488796042609x768734193128308700-AAg","id":"bTUoF","name":"Run javascript page load"},"2":{"properties":{"AAh":{"entries":{"0":"// 変更しやすいように、ターゲットのインデックスを変数化（3番目の要素を選択）\nconst TARGET_INDEX = 0;\n\n// コード1の処理: 指定の .simu_price の値を取得して bubble_fn_simu_price_op() に渡す\nfunction runCode1() {\n  const visiblePriceElements = Array.from(document.querySelectorAll('.simu_price'))\n    .filter(el => window.getComputedStyle(el).display !== 'none');\n\n  if (visiblePriceElements.length > TARGET_INDEX) {\n    const targetElement = visiblePriceElements[TARGET_INDEX];\n    const priceElement = targetElement.querySelector('div');\n\n    if (priceElement) {\n      let value = priceElement.textContent.trim();\n      value = value.slice(1); // 最初の文字を削除（例: ¥123,456 → 123,456）\n      value = value.replace(/,/g, ''); // カンマを削除\n      const numericValue = Number(value);\n\n      if (!isNaN(numericValue)) {\n        console.log(`コード1 - 取得した値: ${numericValue}`);\n        bubble_fn_simu_price_bi(numericValue); // 数値のみ渡す\n      } else {\n        console.warn('コード1 - 数値に変換できませんでした:', value);\n      }\n    } else {\n      console.warn(`コード1 - .simu_price の ${TARGET_INDEX + 1} 番目の要素に <div> がありません。`);\n    }\n  } else {\n    console.warn(`コード1 - 表示されている .simu_price 要素が ${TARGET_INDEX + 1} 個未満です。`);\n  }\n}\n\n// コード2の処理: 全 .simu_price の数値を合計して bubble_fn_simu_price() に渡す\nfunction runCode2() {\n  const priceElements = Array.from(document.querySelectorAll('.simu_price'))\n    .filter(el => window.getComputedStyle(el).display !== 'none')\n    .flatMap(el => Array.from(el.querySelectorAll('div')));\n\n  const total = priceElements\n    .map(element => element.textContent.trim())\n    .map(value => String(value).slice(1))\n    .map(value => value.replace(/,/g, ''))\n    .map(value => Number(value))\n    .filter(value => !isNaN(value))\n    .reduce((sum, value) => sum + value, 0);\n\n  console.log(`コード2 - 合計値: ${total}`);\n}\n\n// 両方のコードを実行する関数\nfunction runBothCodes() {\n  runCode1();\n  runCode2();\n}\n\n// 両方を実行\nrunBothCodes();\n"},"type":"TextExpression"}},"type":"1488796042609x768734193128308700-AAg","id":"bTUoN","name":"Run javascript 9"},"3":{"properties":{"AAh":{"entries":{"0":"// 変更しやすいように、ターゲットのインデックスを変数化（3番目の要素を選択）\nconst TARGET_INDEX = 0;\n\n// コード1の処理: 指定の .simu_price の値を取得して bubble_fn_simu_price_op() に渡す\nfunction runCode1() {\n  const visiblePriceElements = Array.from(document.querySelectorAll('.simu_price'))\n    .filter(el => window.getComputedStyle(el).display !== 'none');\n\n  if (visiblePriceElements.length > TARGET_INDEX) {\n    const targetElement = visiblePriceElements[TARGET_INDEX];\n    const priceElement = targetElement.querySelector('div');\n\n    if (priceElement) {\n      let value = priceElement.textContent.trim();\n      value = value.slice(1); // 最初の文字を削除（例: ¥123,456 → 123,456）\n      value = value.replace(/,/g, ''); // カンマを削除\n      const numericValue = Number(value);\n\n      if (!isNaN(numericValue)) {\n        console.log(`コード1 - 取得した値: ${numericValue}`);\n      } else {\n        console.warn('コード1 - 数値に変換できませんでした:', value);\n      }\n    } else {\n      console.warn(`コード1 - .simu_price の ${TARGET_INDEX + 1} 番目の要素に <div> がありません。`);\n    }\n  } else {\n    console.warn(`コード1 - 表示されている .simu_price 要素が ${TARGET_INDEX + 1} 個未満です。`);\n  }\n}\n\n// コード2の処理: 全 .simu_price の数値を合計して bubble_fn_simu_price() に渡す\nfunctio