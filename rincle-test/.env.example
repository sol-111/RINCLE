# rincle-test 用の環境変数。実値を入れて .env として保存する（.envはgitignore済み・別マシンへ手動で持っていく）
RINCLE_EMAIL = "user@example.com"
RINCLE_PASSWORD = "xxxx"
STORE_EMAIL = "store@example.com"
STORE_PASSWORD = "xxxx"
ADMIN_EMAIL = "admin@example.com"
ADMIN_PASSWORD = "xxxx"
RINCLE_AREA = "栃木県"
# 予約日時: 明日以降・貸出時刻は10:00〜20:00、返却時刻は11:00〜21:00の枠内であること（前日締切）
RINCLE_DATE = 2026/07/20 10:00
RINCLE_TIME = 2026/07/21 11:00
